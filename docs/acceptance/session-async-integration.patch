+package tui
+
+import (
+	"context"
+	"fmt"
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/sausheong/hand/internal/app"
+	"github.com/sausheong/harness/llm"
+	"strings"
+	"time"
+)
+
+func (m *Model) runResumeCommand(args []string) tea.Cmd {
+	if m.controller == nil {
+		m.transcript = append(m.transcript, errorLineStyle.Render("workspace sessions unavailable"))
+		m.refreshViewport()
+		return nil
+	}
+	if len(args) == 0 {
+		records, err := m.controller.ListSessions()
+		if err != nil {
+			m.transcript = append(m.transcript, errorLineStyle.Render(sanitizeForTerminal(err.Error())))
+			m.refreshViewport()
+			return nil
+		}
+		if len(records) == 0 {
+			m.transcript = append(m.transcript, toolCallStyle.Render("no saved sessions"))
+			m.refreshViewport()
+			return nil
+		}
+		active := m.controller.SessionID()
+		for _, record := range records {
+			marker := " "
+			if record.ID == active {
+				marker = "*"
+			}
+			name := record.Name
+			if name == "" {
+				name = "(unnamed)"
+			}
+			m.transcript = append(m.transcript, toolCallStyle.Render(sanitizeForTerminal(fmt.Sprintf("%s %s  %s", marker, record.ID, name))))
+		}
+		m.refreshViewport()
+		return nil
+	}
+	if len(args) != 1 {
+		m.transcript = append(m.transcript, errorLineStyle.Render("usage: /resume [session ID]"))
+		m.refreshViewport()
+		return nil
+	}
+	return m.startSessionChange("resume", func(ctx context.Context) error { return m.controller.ResumeSessionContext(ctx, args[0]) })
+}
+
+func (m *Model) runNameCommand(name string) {
+	name = strings.TrimSpace(name)
+	if m.controller == nil {
+		m.transcript = append(m.transcript, errorLineStyle.Render("workspace sessions unavailable"))
+		return
+	}
+	if name == "" {
+		m.transcript = append(m.transcript, errorLineStyle.Render("usage: /name <session name>"))
+		return
+	}
+	if err := m.controller.RenameSession(name); err != nil {
+		m.transcript = append(m.transcript, errorLineStyle.Render("name failed: "+sanitizeForTerminal(err.Error())))
+		return
+	}
+	m.transcript = append(m.transcript, approvedStyle.Render("session named "+sanitizeForTerminal(name)))
+}
+
+// Reset transient figures rather than attributing another session's usage to
+// the selected history. Persisted accounting is loaded separately when present.
+func (m *Model) resetSessionView() {
+	m.streamBuf.Reset()
+	m.dismissApproval()
+	m.lastUsage = nil
+	m.sessionUsage = llm.Usage{}
+	m.lastModelInfo = app.ModelInfo{}
+	m.toolCallsThisTurn = 0
+	m.lastTurnDuration = 0
+	m.turnStart = time.Time{}
+}
