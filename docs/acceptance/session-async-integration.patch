+		t.Fatal("active run switched session")
+	}
+	snapshot, err := manager.Catalogue().Snapshot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, record := range snapshot.Sessions {
+		if record.Name == "forbidden" {
+			t.Fatal("active run renamed session")
+		}
+	}
+}
