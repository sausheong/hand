+			}
+			m.Update(cmd())
+			if m.identity != before || m.sessionUsage.InputTokens != 77 || m.toolCallsThisTurn != 3 || !strings.Contains(strings.Join(m.transcript, "\n"), "current transcript") {
+				t.Fatal("metadata operation replaced session state")
+			}
+		})
+	}
