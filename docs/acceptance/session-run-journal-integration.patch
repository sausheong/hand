+	if err != nil {
+		t.Fatal(err)
+	}
+	if resumed.Session.ID != fresh.Session.ID || len(resumed.Session.History()) != 1 {
+		t.Fatal("auto-resume lost new session")
+	}
+	resumed.Session.Close()
+	old, err := m.Open(context.Background(), oldID, false)
