+			if err := r.DecideRunTokenBudget(ctx, "job", runLimit); err != nil {
+				t.Fatal(err)
+			}
+			bound, cancel, err := r.PrepareRunBudget(ctx, "job")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer cancel()
+			events, err := r.Run(bound, "blocked", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var terminal error
+			for ev := range events {
+				if ev.Error != nil {
+					terminal = ev.Error
+				}
