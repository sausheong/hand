+	sess, err = store.LoadExclusive("hand", "key")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sess.Close()
+	runs, err := ReadSessionRuns(sess)
+	if err != nil || len(runs) != 2 || runs[0].Finish != nil || runs[1].Finish != nil || runs[0].Start.Model.RequestedModel == runs[1].Start.Model.RequestedModel {
+		t.Fatal(runs, err)
+	}
