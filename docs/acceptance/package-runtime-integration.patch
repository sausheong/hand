+func TestExtensionAnswerModes(t *testing.T) {
+	q := extensions.PendingQuestion{Question: protocol.Question{ID: "q", Title: "Pick", Options: []protocol.Option{{ID: "yes", Label: "Yes"}}, AllowFreeText: true}}
+	for _, tc := range []struct {
