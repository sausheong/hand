+		t.Fatal(err)
+	}
+	page, err := List(ctx, dir, 0)
+	if err != nil || page.Total != 2 || page.Next != 2 || len(page.IDs) != 2 || page.IDs[0] >= page.IDs[1] {
+		t.Fatal(page, err)
+	}
+	if _, err := List(ctx, dir, 3); err == nil {
+		t.Fatal("invalid offset accepted")
