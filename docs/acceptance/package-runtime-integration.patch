+		t.Fatal(err)
+	}
+	if err := Delete(ctx, dir, second, o.Workspace); err == nil {
+		t.Fatal("corrupt evidence silently deleted")
+	}
+	if _, err := os.Stat(filepath.Join(dir, second+".json")); err != nil {
+		t.Fatal("corrupt evidence lost", err)
+	}
