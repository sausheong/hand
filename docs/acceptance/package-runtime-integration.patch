+	}
+	if _, err := owner.EnqueueInput(FollowupQueue, "replacement"); err != nil {
+		t.Fatal(err)
+	}
+	if err := owner.RemoveQueuedInput(input.ID); err == nil {
+		t.Fatal("removed twice")
+	}
