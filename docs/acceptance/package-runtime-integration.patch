+func (c *cancelOnPartialFile) Err() error {
+	entries, _ := os.ReadDir(c.parent)
+	for _, entry := range entries {
+		if _, err := os.Stat(filepath.Join(c.parent, entry.Name(), "note.py")); err == nil {
+			c.cancel()
