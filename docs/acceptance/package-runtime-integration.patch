+func TestOutputCopyEncodesAndReportsWriteErrors(t *testing.T) {
+	var out bytes.Buffer
+	c := clipboardWrite{text: "full \x1b]52;c;untrusted\a output", out: &out}
+	if err := c.Run(); err != nil {
+		t.Fatal(err)
