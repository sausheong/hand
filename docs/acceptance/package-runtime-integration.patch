+		t.Run(mode, func(t *testing.T) {
+			cancelRun := mode != "complete"
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			work := t.TempDir()
+			output, err := process.NewArtifactStore(filepath.Join(t.TempDir(), "output"))
+			if err != nil {
