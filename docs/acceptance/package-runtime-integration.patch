+	backend := &queuedImageBackend{}
+	owner := New(backend, Options{MaxIterations: 1, ResolveInput: func(_ context.Context, text string) (agentio.PromptInput, error) {
+		close(entered)
+		<-release
+		return agentio.PromptInput{Prompt: text}, nil
+	}})
