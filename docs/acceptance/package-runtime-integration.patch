+	backend.WorkerPath = filepath.Join(workspace, "missing-worker")
+	read.Backend = backend
+	if _, err = read.Execute(context.Background(), json.RawMessage(`{"path":"proxy.txt"}`)); err == nil {
+		t.Fatal("missing worker fell back")
+	}
