+		}
+	}
+	if err := s.Set(ctx, MaxStateRevisions, json.RawMessage(`{"new":true}`)); err == nil {
+		t.Fatal("unbounded state journal")
+	}
+	got, err := s.Get(ctx)
+	if err != nil || got.Revision != MaxStateRevisions || string(got.Data) != "{}" {
+		t.Fatal(got, err)
+	}
+}
