+		t.Fatalf("status %+v view %+v", response, view)
+	}
+	if r := d.Dispatch(ctx, rpcRequest("invalid", "budget.tokens.decide", `{"limit":-1,"confirmed":true}`)); r.Error == nil {
+		t.Fatal("invalid ceiling accepted")
+	}
