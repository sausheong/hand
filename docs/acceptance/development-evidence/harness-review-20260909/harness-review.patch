+	cancel()
+	_ = s.Close()
+	if time.Since(start) > 5*time.Second {
+		t.Fatal("stream cleanup exceeded deadline")
+	}
+	if _, err = (Host{}).OpenStream(context.Background(), Request{Argv: []string{"/bin/sh"}, Stdin: []byte("x")}); err == nil {
+		t.Fatal("buffered input accepted")
