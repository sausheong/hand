+}
+
+func TestContainerProtocolPinnedResources(t *testing.T) {
+	image, socket := os.Getenv("HARNESS_TEST_CONTAINER_IMAGE"), os.Getenv("HARNESS_TEST_CONTAINER_SOCKET")
