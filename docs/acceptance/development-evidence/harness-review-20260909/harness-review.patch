+	defer first.Close()
+	id := first.ID
+	empty, err := store.Load("agent", "key")
+	if err != nil || empty.ID != id || len(empty.Entries()) != 0 || empty.LeafID() != "" {
+		t.Fatal("empty identity or graph changed", err)
