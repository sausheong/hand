+	case <-fl.done:
+	case <-ctx.Done():
+		fl.cancel()
+		<-fl.done
+	}
+	m.inFlightMu.Lock()
+	if m.inFlight[stableKey(sess)] == fl {
+		delete(m.inFlight, stableKey(sess))
+	}
+	m.inFlightMu.Unlock()
+	return fl.result, true, fl.err
+}
