+	diagnostic := make(chan string, 1)
+	go func() { b, _ := io.ReadAll(s.Stderr); diagnostic <- string(b) }()
+	if _, err = s.Stdin.Write([]byte("container protocol\n")); err != nil {
+		t.Fatal(err)
