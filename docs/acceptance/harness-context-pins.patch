+		}
+		events, err := r.Run(context.Background(), "continue", nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		done := false
+		for event := range events {
+			if event.Type == EventError {
+				t.Fatal(event.Error)
+			}
+			if event.Type == EventDone {
+				done = true
