+			after := capture(t, work)
+			plan, err := PlanRestore(before, after, after, []string{"file"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			store, _ := newStore(t, work, DefaultStoreLimits())
+			root, err := os.OpenRoot(work)
+			if err != nil {
+				t.Fatal(err)
+			}
