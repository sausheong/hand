+	if err != nil || string(data) != "second" {
+		t.Fatalf("denied write changed file %q %v", data, err)
+	}
+	if calls.Load() != 6 {
+		t.Fatalf("unexpected provider calls %d", calls.Load())
+	}
+	if err = client.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
