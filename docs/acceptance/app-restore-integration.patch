+func (e *steeringExecutor) Execute(ctx context.Context, _ string, _ json.RawMessage) (tool.ToolResult, error) {
+	e.calls++
+	if e.calls == 1 {
+		close(e.entered)
+		select {
+		case <-e.release:
+		case <-ctx.Done():
+			return tool.ToolResult{}, ctx.Err()
+		}
+	}
+	return tool.ToolResult{Output: "read result"}, nil
+}
