+	text := strings.Join(m.transcript, "\n")
+	for _, want := range []string{"optional: unavailable", "[optional]", "healthy: connected (2 tools)"} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("missing %s: %s", want, text)
+		}
+	}
+}
