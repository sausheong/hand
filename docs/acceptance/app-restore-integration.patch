+
+func (*automaticBackend) StopReason() string { return "" }
+func (b *automaticBackend) Run(ctx context.Context, text string, _ []llm.ImageContent) (<-chan app.BackendEvent, error) {
+	if b.before != nil {
+		b.before(text)
