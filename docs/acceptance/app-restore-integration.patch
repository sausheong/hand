+	if err = backend.RecordCheckpoint("finish", pair); err == nil {
+		t.Fatal("unmatched finish accepted")
+	}
+	pair.After = ""
+	if err = backend.RecordCheckpoint("start", pair); err != nil {
+		t.Fatal(err)
