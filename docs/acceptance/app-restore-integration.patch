+	if err != nil {
+		t.Fatal(err)
+	}
+	defer result.Session.Close()
+	summary, err := ReadUsage(result.Session)
+	if err != nil || summary.PriorUsageUnknown || summary.Requests != 0 {
+		t.Fatal(summary, err)
+	}
