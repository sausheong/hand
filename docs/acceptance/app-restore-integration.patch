+	if err = f.Truncate(MaxApprovalSnapshotBytes + 1); err != nil {
+		f.Close()
+		t.Fatal(err)
+	}
+	f.Close()
+	if _, err = snapshotApprovalFile(context.Background(), path); err == nil {
+		t.Fatal("oversized snapshot accepted")
+	}
