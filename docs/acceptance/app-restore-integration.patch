+			fmt.Println("FORK_BOUNDARY")
+			io.Copy(io.Discard, os.Stdin)
+		}
+		return nil
+	}
+	result, err := m.Fork(context.Background(), []session.SessionEntry{session.UserMessageEntry("first"), session.UserMessageEntry("second")})
