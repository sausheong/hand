+	}
+	response = d.Dispatch(context.Background(), rpcRequest("list2", "permission.list", `{}`))
+	if err = json.Unmarshal(response.Result, &listed); err != nil || listed.Total != 0 {
+		t.Fatal("revoked grant still listed")
