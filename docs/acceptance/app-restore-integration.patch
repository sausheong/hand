+	input.Images[0].Data[0] = 'X'
+	retry, err := ParsePromptInput(ctx, workspace, "@\""+image+"\"")
+	if err != nil || string(retry.Images[0].Data) != "original image" {
+		t.Fatalf("mutable grant: %#v %v", retry, err)
