+	p, err := NewAttachmentPolicy(context.Background(), []string{large})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ParsePromptInput(WithAttachmentPolicy(context.Background(), p), t.TempDir(), "@"+large); err == nil {
+		t.Fatal("text size limit bypassed")
+	}
