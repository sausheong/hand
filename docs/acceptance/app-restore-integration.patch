+			if terminal.Kind() != "terminal" || terminal.SessionID() != "sdk-session" || terminal.Status() != "cancelled" {
+				t.Fatalf("terminal %s %s %s", terminal.Kind(), terminal.SessionID(), terminal.Status())
+			}
+			break
