+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+
+	"github.com/charmbracelet/bubbles/textarea"
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/sausheong/hand/internal/agentio"
+	"github.com/sausheong/harness/runtime"
+)
+
+type startupFinished struct{ done chan struct{} }
+type runtimeStartup struct {
+	draft     textarea.Model
+	failed    bool
+	build     func(context.Context) (*runtime.Runtime, error)
+	ctx       context.Context
+	cancel    context.CancelFunc
+	once      sync.Once
+	done      chan struct{}
+	rt        *runtime.Runtime
+	err       error
+	cancelled bool
+	servers   int
+}
+
+func newRuntimeStartup(build func(context.Context) (*runtime.Runtime, error), servers int) *runtimeStartup {
+	ctx, cancel := context.WithTimeout(context.Background(), agentio.DefaultMCPConnectTimeout)
+	draft := textarea.New()
+	draft.CharLimit = 65536
+	draft.SetWidth(76)
+	draft.SetHeight(4)
+	draft.Placeholder = "Draft your prompt while connections initialise"
+	draft.Focus()
+	return &runtimeStartup{draft: draft, build: build, ctx: ctx, cancel: cancel, done: make(chan struct{}), servers: servers}
+}
+func (s *runtimeStartup) start() {
+	s.once.Do(func() { go func() { defer close(s.done); s.rt, s.err = s.build(s.ctx) }() })
+}
+func (s *runtimeStartup) Init() tea.Cmd {
+	s.start()
+	done := s.done
+	return func() tea.Msg { <-done; return startupFinished{done} }
+}
+func (s *runtimeStartup) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
+	switch msg := msg.(type) {
+	case startupFinished:
+		if msg.done != s.done {
+			return s, nil
+		}
+		<-s.done
+		if s.err != nil && !s.cancelled {
+			s.failed = true
+			return s, nil
+		}
+		return s, tea.Quit
+	case tea.WindowSizeMsg:
+		s.draft.SetWidth(max(1, msg.Width-4))
+		s.draft.SetHeight(max(1, min(6, msg.Height-9)))
+		return s, nil
+	case tea.KeyMsg:
+		if msg.String() == "ctrl+c" || msg.String() == "esc" {
+			s.cancelled = true
+			s.cancel()
+			if s.failed {
+				return s, tea.Quit
+			}
+			return s, nil
+		}
+		if msg.String() == "ctrl+r" && s.failed {
+			s.cancel()
+			if s.rt != nil {
+				_ = s.rt.Close()
+				s.rt = nil
+			}
+			s.ctx, s.cancel = context.WithTimeout(context.Background(), agentio.DefaultMCPConnectTimeout)
+			s.once = sync.Once{}
+			s.done = make(chan struct{})
+			s.err = nil
+			s.failed = false
+			return s, s.Init()
+		}
+	}
+	if s.cancelled {
+		return s, nil
+	}
+	var cmd tea.Cmd
+	s.draft, cmd = s.draft.Update(msg)
+	return s, cmd
+}
+func (s *runtimeStartup) View() string {
+	if s.cancelled {
+		return "Hand — cancelling startup and closing MCP connections…\n"
+	}
+	state := fmt.Sprintf("Connecting %d MCP server(s)…", s.servers)
+	if s.failed {
+		state = "Required MCP startup failed. Ctrl+R retries; Esc quits."
+	}
+	return "Hand\n\n" + state + "\nRuns wait for required connections. Your draft is preserved.\n\n" + s.draft.View() + "\n\nEsc / Ctrl+C: cancel and close connections\n"
+
+}
+
+// finish also covers terminal disconnects before Init, and joins construction
+// before the session/registry owner is released. Call after Program.Run only.
+func (s *runtimeStartup) finish(programErr error) (*runtime.Runtime, error) {
+	s.cancel()
+	s.start()
+	<-s.done
+	err := errors.Join(programErr, s.err)
+	if s.cancelled {
+		err = errors.Join(err, context.Canceled)
+	}
+	if err != nil && s.rt != nil {
+		err = errors.Join(err, s.rt.Close())
+		s.rt = nil
+	}
+	return s.rt, err
+}
+func buildInteractiveRuntime(deps runtime.RuntimeDeps, inputs runtime.RuntimeInputs, spec runtime.AgentSpec) (*runtime.Runtime, string, error) {
+	if len(spec.MCPServers) == 0 {
+		rt, err := runtime.BuildRuntime(deps, inputs, spec)
+		return rt, "", err
+	}
+	startup := newRuntimeStartup(func(ctx context.Context) (*runtime.Runtime, error) {
+		return runtime.BuildRuntimeContext(ctx, deps, inputs, spec)
+	}, len(spec.MCPServers))
+	program := tea.NewProgram(startup, tea.WithAltScreen())
+	_, err := program.Run()
+	rt, err := startup.finish(err)
+	return rt, startup.draft.Value(), err
+}
