 	"os"
@@ -167,6 +168,18 @@ func (c Container) Run(ctx context.Context, r Request) (result Result, err error
 	}
 	defer os.RemoveAll(config)
 	base := []string{"--config", config, "--host", "unix://" + c.Socket}
+	inspectCtx, inspectCancel := context.WithTimeout(ctx, 5*time.Second)
+	inspected, inspectErr := run(inspectCtx, "", environment(nil), nil, c.Docker, append(append([]string{}, base...), "image", "inspect", "--format", "{{json .Config.Volumes}}", c.Image)...)
+	inspectCancel()
