+		t.Fatal("fork replay included unrelated branch")
+	}
+	fork.Append(session.UserMessageEntry("fork-only continuation"))
+	if err := fork.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	original, err := manager.Open(context.Background(), source.ID, false)
+	if err != nil {
+		t.Fatal(err)
+	}
