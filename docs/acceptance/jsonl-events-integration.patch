+			<-start
+			stream, err := llm.ObserveChat(ctx, llm.ChatRequest{Model: "model"}, llm.CallGeneration, func(context.Context, llm.ChatRequest) (<-chan llm.ChatEvent, error) {
+				ch := make(chan llm.ChatEvent, 1)
