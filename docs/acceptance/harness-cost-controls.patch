+	if err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	for range ch {
+	}
+	r := <-settled
+	if r.Status != "cancelled" || r.Usage != nil {
+		t.Fatalf("record %+v", r)
+	}
+	select {
+	case <-settled:
+		t.Fatal("double settlement")
+	default:
+	}
+}
