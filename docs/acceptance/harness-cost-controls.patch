+func TestCostConcurrentOwnersAndExplicitResume(t *testing.T) {
+	ctx := context.Background()
+	s := session.NewSession("a", "cost")
+	a, _ := OpenCostLedger(s)
+	b, _ := OpenCostLedger(s)
+	if err := a.Decide(ctx, "USD", 500000, true); err != nil {
